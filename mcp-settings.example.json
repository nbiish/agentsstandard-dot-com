{
  "$schema": "https://agentsstandard.com/schemas/mcp-settings.json",
  "version": "1.0.0",
  "description": "Universal MCP server configuration — all agents read from ~/.agents/mcp-settings.json",

  "mcpServers": {
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "autoApprove": ["brave_web_search", "brave_local_search"],
      "disabled": false
    },
    "tavily-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "autoApprove": ["tavily_search", "tavily_extract"],
      "disabled": false
    },
    "browsermcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@browsermcp/mcp@latest"],
      "env": {},
      "autoApprove": ["browser_navigate", "browser_snapshot", "browser_click", "browser_type", "browser_screenshot"],
      "disabled": false
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest", "--autoConnect", "--channel=beta"],
      "env": {},
      "autoApprove": ["take_snapshot", "list_pages", "navigate_page", "click", "fill", "evaluate_script"],
      "disabled": false
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"],
      "env": {},
      "autoApprove": ["resolve-library-id", "get-library-docs"],
      "disabled": false
    },
    "firecrawl-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "autoApprove": ["firecrawl_scrape", "firecrawl_search", "firecrawl_map"],
      "disabled": false
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "autoApprove": ["search_repositories", "get_file_contents", "list_issues", "list_pull_requests"],
      "disabled": false
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {},
      "autoApprove": ["browser_navigate", "browser_snapshot", "browser_click"],
      "disabled": false
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-filesystem", "/path/to/allowed/dir"],
      "env": {},
      "autoApprove": ["read_file", "list_directory", "search_files"],
      "disabled": false,
      "timeout": 30000
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-memory"],
      "env": {},
      "autoApprove": ["create_entities", "create_relations", "read_graph", "search_nodes"],
      "disabled": false
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-postgres", "${DATABASE_URL}"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "autoApprove": [],
      "disabled": true,
      "note": "Enable when working with databases"
    },
    "figma-remote": {
      "type": "sse",
      "url": "https://mcp.figma.com/mcp",
      "headers": {
        "Authorization": "Bearer ${FIGMA_API_KEY}"
      },
      "autoApprove": ["get_design_context", "get_screenshot"],
      "disabled": false
    }
  },

  "global": {
    "autoApproveDefaults": {
      "read_only": true,
      "note": "When true, auto-approve all read-only tools (read, search, list, get) across all servers"
    },
    "disabledTools": [],
    "maxToolCallsPerTurn": 50,
    "toolCallTimeout": 60000
  }
}
